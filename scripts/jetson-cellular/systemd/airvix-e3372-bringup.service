[Unit]
Description=AIRVIX Huawei E3372 bring-up when the USB stick appears
Documentation=file:///opt/airvix/jetson-cellular/README.md
After=local-fs.target
# udev SYSTEMD_WANTS starts this on a matching Huawei net/tty.
# Boot enable is skipped unless cdc-wdm0 or a Huawei 12d1 enx* netdev exists.
# The on-board USB gadget is not the modem. Do not key off /dev/ttyUSB0.
ExecCondition=/opt/airvix/jetson-cellular/e3372-boot-trigger.sh

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/airvix/e3372.env
ExecStart=/opt/airvix/jetson-cellular/e3372-bringup.sh
SuccessExitStatus=0
# No APN write. No MAVLink send. No annotated-video start. No Companion apply.

[Install]
WantedBy=multi-user.target
