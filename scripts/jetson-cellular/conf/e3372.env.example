# Copy to /etc/airvix/e3372.env on the Jetson. Leave values empty until the
# stick is on the bench. Never put APN passwords, tokens, or host addresses here.

# Console dual-link stays mock/absent until USB is present:
# AIRVIX_CELLULAR_MOCK=present
# CELLULAR_MODEM_MOCK=present

# Optional override for the status file (default /run/airvix/e3372.status):
# AIRVIX_E3372_STATUS_FILE=/run/airvix/e3372.status

# Cellular MAVLink second path — same default as console dual-link.
# --bind is operator-started. Install does not auto-start it.
# AIRVIX_CELLULAR_MAVLINK_TYPE=udp
# AIRVIX_CELLULAR_MAVLINK_HOST=0.0.0.0
# AIRVIX_CELLULAR_MAVLINK_PORT=14560
# AIRVIX_CELLULAR_BIND_FORCE=
# AIRVIX_ANNOTATED_STREAM_URL=
# AIRVIX_ANNOTATED_STREAM_FILE=/run/airvix/annotated-stream.status
# AIRVIX_ANNOTATED_VIDEO_BIND=cellular

# Keep Tailscale up when the cell NIC appears (check only; no start from here):
# AIRVIX_TAILSCALE_KEEP_UP=1
