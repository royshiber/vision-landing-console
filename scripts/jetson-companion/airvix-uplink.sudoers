# AIRVIX uplink control. One script, four verbs, no other nmcli rights.
# The privileged script is root-owned at this path only (root:root, mode 0755):
#   /opt/airvix/jetson-companion/uplink-nm.sh
# companion_agent.py runs as royshiber from /home/royshiber/vlc-companion.
# Do not grant sudo on the copy in that home directory.
#
# Install on the Jetson (operator, not the cloud agent):
#   sudo install -d -o root -g root -m 0755 /opt/airvix/jetson-companion
#   sudo install -o root -g root -m 0755 uplink-nm.sh /opt/airvix/jetson-companion/uplink-nm.sh
#   sudo install -m 440 airvix-uplink.sudoers /etc/sudoers.d/airvix-uplink
#   sudo visudo -cf /etc/sudoers.d/airvix-uplink

royshiber ALL=(root) NOPASSWD: /opt/airvix/jetson-companion/uplink-nm.sh
