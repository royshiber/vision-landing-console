# Copy to ~/vlc-companion/flightlog-storage.env and chmod 600.
# Do not commit the live file. Leave the secret empty in git.
# Create-only GCS HMAC key: PUT of a new object returns 200.
# GET, DELETE, LIST, and overwrite are denied for this key.
AIRVIX_S3_ENDPOINT=https://storage.googleapis.com
AIRVIX_S3_REGION=auto
AIRVIX_S3_BUCKET=airvix-flight-logs-489409
AIRVIX_S3_KEY_ID=
AIRVIX_S3_SECRET=
