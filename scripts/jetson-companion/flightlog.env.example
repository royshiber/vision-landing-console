# AIRVIX flight logger. Copy to /etc/airvix/flightlog.env on the Jetson.
# Placeholders only. Do not put a real key in git.
# Use an S3-compatible credential that can write objects only,
# limited to this bucket and the name prefix v1/<vehicle_id>/.

# Master switch. 0 exits 0 and writes enabled:false. Default off.
AIRVIX_FLIGHTLOG_ENABLED=0
AIRVIX_FLIGHTLOG_RELAY=127.0.0.1:5770
AIRVIX_FLIGHTLOG_DIR=/var/lib/airvix/flightlog
AIRVIX_FLIGHTLOG_STATUS_FILE=/run/airvix/flightlog.json
AIRVIX_FLIGHTLOG_TLOG_QUOTA_MB=2048
AIRVIX_FLIGHTLOG_RETENTION_DAYS=14
AIRVIX_FLIGHTLOG_PREROLL_S=60
AIRVIX_FLIGHTLOG_POSTROLL_S=30
AIRVIX_FLIGHTLOG_JOURNAL_UNITS=airvix-companion,airvix-flightlog,airvix-e3372-bringup,airvix-e3372-status,NetworkManager,ModemManager,tailscaled
AIRVIX_VEHICLE_ID=

# Detector thresholds (design defaults).
AIRVIX_FD_ASPD_MIN=9
AIRVIX_FD_GSPD_MIN=8
AIRVIX_FD_ALT_MIN=8
AIRVIX_FD_ASPD_FAST=13
AIRVIX_FD_GSPD_FAST=11
AIRVIX_FD_ALT_STRONG=15
AIRVIX_FD_CONFIRM_S=5
AIRVIX_FD_CONFIRM_RATIO=0.8
AIRVIX_FD_DISP_MIN=30
AIRVIX_FD_LAND_STILL_S=20
AIRVIX_FD_LINK_LOST_CLOSE_S=120

# Upload. Missing endpoint, region, bucket, key id, or secret => no-op, credential absent.
# Logs stay on disk under the retention cap. A later restart with these set uploads the queue.
# Google Cloud Storage S3 interoperability (chosen target):
#   AIRVIX_UPLOAD_ENDPOINT=https://storage.googleapis.com
#   AIRVIX_UPLOAD_REGION=auto
#   or AIRVIX_UPLOAD_REGION=me-west1   (bucket location; Tel Aviv)
#   AIRVIX_UPLOAD_KEY_ID=              HMAC access id
#   AIRVIX_UPLOAD_SECRET=              HMAC secret
# Use the global endpoint above. Do not put the bucket name in the host.
# AIRVIX_UPLOAD_APP_KEY is an accepted alias for AIRVIX_UPLOAD_SECRET.
AIRVIX_UPLOAD_ENABLED=0
AIRVIX_UPLOAD_ENDPOINT=
AIRVIX_UPLOAD_REGION=
AIRVIX_UPLOAD_BUCKET=
AIRVIX_UPLOAD_KEY_ID=
AIRVIX_UPLOAD_SECRET=
AIRVIX_UPLOAD_PREFIX=v1
AIRVIX_UPLOAD_CELLULAR=all
AIRVIX_UPLOAD_CELL_DAILY_MB=500
AIRVIX_UPLOAD_WHILE_ARMED=control_only
AIRVIX_UPLOAD_BW_KBPS=256
